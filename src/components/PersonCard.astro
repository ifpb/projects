---
import type { CollectionEntry } from "astro:content";
import type { Student } from "@/content.config";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import peoplePlaceholder from "@/assets/people-placeholder.png";
import Badge from "@/components/Badge.astro";
import { getProjectsByPerson } from "@/helpers/projects";
import {
  getFirstPersonId,
  getPersonTags,
  getAvatarImageUrl,
  isProfessor,
  isStudent,
} from "@/helpers/people";
import {
  getCourseAbbreviationByOccupation,
  getCourseAbbreviationCampusByOccupation,
  getCourseByAbbreviation,
} from "@/helpers/courses";
import { courseLevels } from "@/lib/taxonomy";

export interface Props {
  person: CollectionEntry<"people">;
  eager?: boolean;
}

const links = [
  { name: "linkedin", label: "LinkedIn", icon: "ph:linkedin-logo-bold" },
  { name: "github", label: "GitHub", icon: "mdi:github" },
  { name: "figma", label: "Figma", icon: "ph:figma-logo-bold" },
  { name: "instagram", label: "Instagram", icon: "ph:instagram-logo-bold" },
  { name: "homepage", label: "Site pessoal", icon: "ph:globe-bold" },
  { name: "researchgate", label: "ResearchGate", icon: "la:researchgate" },
  {
    name: "lattes",
    label: "Currículo Lattes",
    icon: "ph:identification-card-bold",
  },
];

const { person, eager = false } = Astro.props;
const { name, addresses, occupations } = person.data;
const id = getFirstPersonId(person);
const profileUrl = `/projects/people/${id}/`;
const projects = await getProjectsByPerson(person);
const availableLinks = links
  .filter((link) => addresses[link.name])
  .map((link) => ({ ...link, url: addresses[link.name] }));
const tags = await getPersonTags(person);

const egressoOccupations = occupations.filter(
  (occupation): occupation is Student =>
    occupation.type === "student" && occupation.isFinished,
);

const getLevelIndex = (courseAbbr: string) => {
  const course = getCourseByAbbreviation(courseAbbr);
  const lvl = course?.data?.level?.compact?.split(" ")[0]?.toLowerCase() ?? "";
  const idx = courseLevels.indexOf(lvl);
  return idx !== -1 ? idx : 0;
};

// Ordena todos os egressos pela maior titulação (doutorado > mestrado > graduação > técnico)
const sortedEgressos = [...egressoOccupations].sort(
  (a, b) => getLevelIndex(b.course) - getLevelIndex(a.course),
);

// Ocupações de estudantes ativos (não finalizados)
const activeStudentOccupations = occupations.filter(
  (occupation): occupation is Student =>
    occupation.type === "student" &&
    !occupation.isFinished &&
    !!occupation.course,
);

const allPersonBadges = [
  ...sortedEgressos.map((occupation) => ({
    url: `/projects/people/egresso-${occupation.course}/1`,
    text: `egresso-${occupation.course}`,
  })),
  ...(isProfessor(person)
    ? [{ url: "/projects/people/professor/1", text: "professor" }]
    : []),
  ...(isStudent(person)
    ? occupations
        .filter(
          (occupation): occupation is Student =>
            occupation.type === "student" && !!occupation.course,
        )
        .map((occupation) => ({
          url: `/projects/people/${getCourseAbbreviationByOccupation(occupation)}/1`,
          text: getCourseAbbreviationCampusByOccupation(occupation),
        }))
    : []),
].filter(
  (badge, index, badges) =>
    badges.findIndex((candidate) => candidate.url === badge.url) === index,
);

const visibleBadges = allPersonBadges.slice(0, 2);
const hiddenBadges = allPersonBadges.slice(2);
const avatarUrl = getAvatarImageUrl(person, 400);
---

<article
  class="person-card surface-card group relative flex h-full min-w-0 flex-col"
  data-tags={tags.join("-")}
>
  <a
    href={profileUrl}
    class="relative block overflow-hidden rounded-t-[7px] bg-gray-200"
    aria-label={`Ver perfil de ${name.full}`}
  >
    <Image
      src={peoplePlaceholder}
      alt={name.full}
      width={400}
      height={400}
      class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-[1.025]"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      data-src={avatarUrl}
      onload="onLoadPersonImage(this)"
      onerror="onErrorPersonImage(this)"
    />
    {projects.length > 0 && (
      <span class="absolute bottom-3 left-3 rounded bg-gray-950/85 px-2 py-1 text-[10px] font-extrabold uppercase text-white backdrop-blur">
        {projects.length} projeto{projects.length !== 1 ? "s" : ""}
      </span>
    )}
  </a>

  <div class="flex flex-1 flex-col p-3 sm:p-4">
    <h2
      class="text-base font-extrabold leading-snug text-gray-950 sm:text-lg"
      data-pagefind-ignore
    >
      <a href={profileUrl} class="hover:text-green-800">
        {name.compact}
      </a>
    </h2>

    <div class="mt-2.5 mb-3 flex flex-wrap gap-1 sm:mt-3 sm:mb-4 sm:gap-1.5">
      {visibleBadges.map((badge) => (
        <Badge url={badge.url} text={badge.text} />
      ))}
      {hiddenBadges.length > 0 && (
        <div class="group/tooltip relative inline-flex items-center">
          <button
            type="button"
            class="inline-flex cursor-pointer items-center rounded-full border border-gray-200 bg-gray-100 px-2 py-0.5 text-[10px] font-bold text-gray-600 transition-colors hover:border-gray-300 hover:bg-gray-200 focus-visible:ring-2 focus-visible:ring-green-600 focus-visible:outline-none sm:px-2.5 sm:py-1 sm:text-[11px]"
            aria-label={`Mais ${hiddenBadges.length} tag${hiddenBadges.length > 1 ? "s" : ""}: ${hiddenBadges.map((badge) => badge.text).join(", ")}`}
          >
            +{hiddenBadges.length}
          </button>

          <div
            role="tooltip"
            class="invisible absolute bottom-full left-1/2 z-40 mb-2 -translate-x-1/2 opacity-0 shadow-xl transition-all duration-150 ease-out before:absolute before:top-full before:left-0 before:right-0 before:h-2 before:content-[''] group-hover/tooltip:visible group-hover/tooltip:opacity-100 group-focus-within/tooltip:visible group-focus-within/tooltip:opacity-100"
          >
            <div class="relative w-max max-w-[220px] rounded-lg border border-gray-800 bg-gray-950/95 p-2 text-white shadow-2xl backdrop-blur sm:max-w-[260px]">
              <div class="mb-1.5 flex items-center justify-between gap-2 border-b border-gray-800 pb-1 text-[9px] font-bold uppercase tracking-wider text-gray-400">
                <span>
                  {hiddenBadges.length === 1
                    ? "Tag oculta"
                    : `Tags ocultas (${hiddenBadges.length})`}
                </span>
              </div>
              <div class="flex flex-wrap gap-1">
                {hiddenBadges.map((badge) => (
                  <a
                    href={badge.url}
                    class="inline-block rounded border border-white/10 bg-white/10 px-1.5 py-0.5 text-[10px] font-medium text-gray-200 transition-colors hover:border-green-500 hover:bg-green-600 hover:text-white"
                  >
                    {badge.text}
                  </a>
                ))}
              </div>
              <div class="pointer-events-none absolute top-full left-1/2 -mt-px -translate-x-1/2 border-4 border-transparent border-t-gray-950/95" />
            </div>
          </div>
        </div>
      )}
    </div>

    <div class="mt-auto flex items-center justify-between border-t border-gray-100 pt-3 sm:pt-4">
      <div class="flex items-center gap-0.5 sm:gap-1">
        {availableLinks.slice(0, 4).map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            title={link.label}
            aria-label={link.label}
            class="grid h-7 w-7 sm:h-8 sm:w-8 place-items-center rounded text-gray-500 transition-colors hover:bg-green-50 hover:text-green-800"
          >
            <Icon
              name={link.icon}
              size={17}
              class={`${link.name}-person-link sm:w-[19px] sm:h-[19px]`}
              is:inline
            />
          </a>
        ))}
      </div>
      <a
        href={profileUrl}
        title="Ver perfil"
        aria-label={`Ver perfil de ${name.full}`}
        class="grid h-7 w-7 sm:h-8 sm:w-8 place-items-center rounded text-green-800 hover:bg-green-50"
      >
        <Icon name="ph:arrow-right-bold" size={16} />
      </a>
    </div>
  </div>
</article>
