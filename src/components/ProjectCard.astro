---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getPreviewImage } from '@/lib/previews';
import Badge from '@/components/Badge.astro';
import { getProjectId, getProjectTags } from '@/helpers/projects';
import { getAvatarImageUrl, getFirstPersonId } from '@/helpers/people';

type ProjectsWithPeople = CollectionEntry<'projects'> & {
  people: CollectionEntry<'people'>[];
};

export interface Props {
  project: ProjectsWithPeople;
  /** Cards da primeira fileira ficam acima da dobra e não devem ser lazy. */
  eager?: boolean;
}

const { project, eager = false } = Astro.props;

const {
  data: { addresses, name },
} = project;

const tags: string[] = getProjectTags(project);

const projectId = getProjectId(project);

// Preview local otimizado; ausente quando a URL do YAML está morta (ver
// scripts/fetch-previews.mjs), caso em que o card usa o placeholder.
const previewImage = getPreviewImage(project.id);
---

<div
  class="project-card md:max-w-[320px] rounded-md overflow-hidden shadow-lg bg-white text-center"
>
  <section class="relative z-0">
    <figure class="overflow-hidden shadow-md">
      <a
        href={addresses.homepage ||
          (Array.isArray(addresses.repository)
            ? addresses.repository[0]
            : addresses.repository)}
        target="_blank"
      >
        {
          previewImage ? (
            <Image
              src={previewImage}
              width={640}
              class="bg-gray-300 object-cover w-full h-[200px] md:h-[150px] hover:scale-105 transition duration-500"
              alt={name}
              loading={eager ? 'eager' : 'lazy'}
              decoding="async"
            />
          ) : (
            <img
              src="/projects/imgs/project-placeholder.png"
              class="bg-gray-300 object-cover w-full h-[200px] md:h-[150px] hover:scale-105 transition duration-500"
              alt={name}
              loading={eager ? 'eager' : 'lazy'}
              decoding="async"
            />
          )
        }
      </a>
    </figure>
    <div class="absolute top-2 right-2">
      <ul class="flex">
        {
          addresses.homepage && (
            <li class="-mr-2 bg-black border-2 border-gray-100 rounded-full overflow-hidden w-9 flex items-center justify-center">
              <a
                href={addresses.homepage}
                target="_blank"
                class="font-bold flex items-center justify-center text-white"
                title="Homepage"
                aria-label="Homepage do projeto"
              >
                <Icon
                  name="ph:monitor-duotone"
                  size={25}
                  class="homepage-project-link"
                />
              </a>
            </li>
          )
        }
        {
          addresses.design && (
            <li class="-mr-2 bg-black border-2 border-gray-100 rounded-full overflow-hidden w-9 flex items-center justify-center">
              <a
                href={addresses.design}
                target="_blank"
                class="font-bold flex items-center justify-center text-white"
                title="Design"
                aria-label="Design do projeto"
              >
                {addresses.design.includes('figma.com') ? (
                  <Icon
                    name="logos:figma"
                    size={32}
                    class="figma-project-link"
                  />
                ) : addresses.design.includes('canva.com') ? (
                  <Icon
                    name="simple-icons:canva"
                    size={32}
                    class="canva-project-link"
                  />
                ) : (
                  <Icon
                    name="clarity:design-line"
                    size={20}
                    class="design-project-link"
                  />
                )}
              </a>
            </li>
          )
        }
        {
          addresses.workflow && (
            <li class="-mr-2 bg-black border-2 border-gray-100 rounded-full overflow-hidden w-9 flex items-center justify-center">
              <a
                href={addresses.workflow}
                target="_blank"
                class="font-bold flex items-center justify-center text-white"
                title="Workflow"
                aria-label="Workflow do projeto"
              >
                <Icon
                  name="uil:schedule"
                  size={22}
                  class="workflow-project-link"
                />
              </a>
            </li>
          )
        }
        {
          Array.isArray(addresses.repository) ? (
            addresses.repository.map((repo, index) => (
              <li class="-mr-2 bg-black border-2 border-gray-100 rounded-full overflow-hidden w-9">
                <a
                  href={repo}
                  target="_blank"
                  class="font-bold flex items-center justify-center"
                  title={`Repositório ${index + 1}`}
                  aria-label={`Repositório ${index + 1}`}
                >
                  <Icon
                    name="uim:github"
                    size={32}
                    class="github-project-link"
                    is:inline
                  />
                </a>
              </li>
            ))
          ) : (
            <li class="-mr-2 bg-black border-2 border-gray-100 rounded-full overflow-hidden w-9">
              <a
                href={addresses.repository}
                target="_blank"
                title="Repositório"
                aria-label="Repositório"
                class="font-bold flex items-center justify-center"
              >
                <Icon
                  name="uim:github"
                  size={32}
                  class="github-project-link"
                  is:inline
                />
              </a>
            </li>
          )
        }
      </ul>
    </div>
    <ul class="absolute bottom-2 right-4 flex">
      {
        !!project.people?.length &&
          project.people
            ?.sort((a, b) => a.data.name.full.localeCompare(b.data.name.full))
            ?.map((person) => (
              <li class="-mr-2 border-2 border-gray-100 rounded-full">
                <a
                  href={`/projects/people/${getFirstPersonId(person)}/`}
                  target="_blank"
                  class="animate-pulse"
                >
                  <img
                    src="/projects/imgs/people-placeholder.png"
                    alt={person.data.name.full}
                    title={person.data.name.full}
                    class="rounded-full bg-gray-300 object-cover w-8"
                    loading={eager ? 'eager' : 'lazy'}
                    data-src={getAvatarImageUrl(person, 128)}
                    onload="onLoadPersonImage(this, 32)"
                    onerror="onErrorPersonImage(this)"
                  />
                </a>
              </li>
            ))
      }
    </ul>
  </section>
  <p class="my-3">
    <a
      href={`/projects/codes/${projectId}`}
      target="_blank"
      class="font-bold underline"
    >
      {name}
    </a>
  </p>
  <nav class="m-3 px-2 space-x-1">
    {
      tags
        .filter((tag, index, self) => self.indexOf(tag) === index)
        .filter((tag) => tag !== 'subject')
        .map((tag) => <Badge url={`/projects/codes/${tag}/1/`} text={tag} />)
    }
  </nav>
</div>
