---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getPreviewImage } from "@/lib/previews";
import projectPlaceholder from "@/assets/project-placeholder.png";
import peoplePlaceholder from "@/assets/people-placeholder.png";
import Badge from "@/components/Badge.astro";
import { getProjectId, getProjectTags } from "@/helpers/projects";
import { getAvatarImageUrl, getFirstPersonId } from "@/helpers/people";

type ProjectsWithPeople = CollectionEntry<"projects"> & {
  people: CollectionEntry<"people">[];
};
export interface Props {
  project: ProjectsWithPeople;
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const { addresses, name, description, category } = project.data;
const allTags = getProjectTags(project)
  .filter((tag, index, self) => self.indexOf(tag) === index)
  .filter((tag) => tag !== "subject");

// Mantém a faixa em uma linha: tags longas cedem lugar às próximas tags curtas.
const visibleTags: string[] = [];
let visibleCharacters = 0;
for (const tag of allTags) {
  const tagWidth = tag.length + 2;
  if (
    visibleTags.length < 3 &&
    tag.length <= 14 &&
    visibleCharacters + tagWidth <= 28
  ) {
    visibleTags.push(tag);
    visibleCharacters += tagWidth;
  }
}
const hiddenTags = allTags.filter((tag) => !visibleTags.includes(tag));
const projectId = getProjectId(project);
const detailUrl = `/projects/codes/${projectId}`;
const previewImage = getPreviewImage(project.id);
const repositories = Array.isArray(addresses.repository)
  ? addresses.repository
  : [addresses.repository];
const designUrl = addresses.template ?? addresses.design;
const designLabel = addresses.template ? "Abrir template" : "Abrir design";
const categoryLabels = {
  subject: "Disciplina",
  research: "Pesquisa",
  extension: "Extensão",
  "open source": "Open source",
};
---

<article class="project-card surface-card group flex h-full min-w-0 flex-col overflow-hidden">
  <div class="relative overflow-hidden bg-gray-200">
    <a href={detailUrl} aria-label={`Ver projeto ${name}`}>
      <Image
        src={previewImage ?? projectPlaceholder}
        width={640}
        height={360}
        class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.025]"
        alt={name}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
    </a>
    <div class="absolute left-3 top-3 rounded bg-gray-950/85 px-2 py-1 text-[10px] font-extrabold uppercase text-white backdrop-blur">
      {categoryLabels[category.type] ?? category.type}
    </div>
    <div class="absolute right-3 top-3 flex gap-1.5">
      {repositories.slice(0, 2).map((repository, index) => (
        <a
          href={repository}
          target="_blank"
          rel="noopener noreferrer"
          class="grid h-8 w-8 place-items-center rounded bg-gray-950 text-white shadow-sm transition-colors hover:bg-green-700"
          title={`Repositório ${index + 1}`}
          aria-label={`Repositório ${index + 1}`}
        >
          <Icon
            name="mdi:github"
            size={18}
            class="github-project-link"
            is:inline
          />
        </a>
      ))}
      {designUrl && (
        <a
          href={designUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="grid h-8 w-8 place-items-center rounded bg-white text-gray-800 shadow-sm transition-colors hover:bg-green-700 hover:text-white"
          title={designLabel}
          aria-label={designLabel}
        >
          <Icon name="ph:paint-brush-bold" size={17} />
        </a>
      )}
      {addresses.workflow && (
        <a
          href={addresses.workflow}
          target="_blank"
          rel="noopener noreferrer"
          class="grid h-8 w-8 place-items-center rounded bg-white text-gray-800 shadow-sm transition-colors hover:bg-green-700 hover:text-white"
          title="Abrir workflow"
          aria-label="Abrir workflow"
        >
          <Icon name="ph:kanban-bold" size={18} />
        </a>
      )}
      {addresses.homepage && (
        <a
          href={addresses.homepage}
          target="_blank"
          rel="noopener noreferrer"
          class="grid h-8 w-8 place-items-center rounded bg-white text-gray-800 shadow-sm transition-colors hover:bg-green-700 hover:text-white"
          title="Abrir homepage"
          aria-label="Abrir homepage"
        >
          <Icon name="ph:arrow-square-out-bold" size={17} />
        </a>
      )}
    </div>
  </div>

  <div class="flex flex-1 flex-col p-3.5 sm:p-4">
    <h2 class="line-clamp-2 h-12 text-base font-extrabold leading-snug text-gray-950 sm:text-lg">
      <a href={detailUrl} class="hover:text-green-800">
        {name}
      </a>
    </h2>
    <p class="mt-2 line-clamp-2 h-12 text-sm leading-6 text-gray-600">
      {description}
    </p>
    <nav
      class="mt-4 mb-4 flex min-h-7 flex-nowrap items-center gap-1.5 overflow-hidden"
      aria-label={`Tags de ${name}`}
    >
      {visibleTags.map((tag) => (
        <Badge url={`/projects/codes/${tag}/1/`} text={tag} />
      ))}
      {hiddenTags.length > 0 && (
        <span
          class="ml-auto inline-flex shrink-0 items-center rounded-full border border-gray-200 bg-gray-100 px-2.5 py-1 text-[11px] font-bold text-gray-600"
          title={hiddenTags.join(", ")}
          aria-label={`Mais ${hiddenTags.length} tags: ${hiddenTags.join(", ")}`}
        >
          +{hiddenTags.length}
        </span>
      )}
    </nav>

    <div class="mt-auto flex items-center justify-between border-t border-gray-100 pt-4">
      <div class="flex min-h-8 -space-x-2">
        {project.people
          ?.slice(0, 4)
          .sort((a, b) => a.data.name.full.localeCompare(b.data.name.full))
          .map((person) => (
            <a
              href={`/projects/people/${getFirstPersonId(person)}/`}
              title={person.data.name.full}
              class="rounded-full ring-2 ring-white"
            >
              <Image
                src={peoplePlaceholder}
                alt={person.data.name.full}
                width={32}
                height={32}
                class="h-8 w-8 rounded-full bg-gray-200 object-cover"
                loading={eager ? "eager" : "lazy"}
                data-src={getAvatarImageUrl(person, 128)}
                onload="onLoadPersonImage(this, 32)"
                onerror="onErrorPersonImage(this)"
              />
            </a>
          ))}
      </div>
      <a
        href={detailUrl}
        class="inline-flex items-center gap-1 text-xs font-extrabold text-green-800 hover:text-green-950"
      >
        Ver projeto <Icon name="ph:arrow-right-bold" size={15} />
      </a>
    </div>
  </div>
</article>
