---
import { Icon } from "astro-icon/components";
---

<button
  id="search-command"
  type="button"
  class="flex h-10 items-center justify-center gap-2 rounded-md border border-gray-200 bg-gray-50 px-2.5 text-gray-600 transition-colors hover:border-gray-300 hover:bg-white hover:text-gray-950 sm:min-w-44 sm:justify-between sm:px-3"
  aria-label="Pesquisar projetos e comunidade"
  aria-haspopup="dialog"
>
  <span class="flex items-center gap-2">
    <Icon name="ph:magnifying-glass-bold" size={18} />
    <span class="hidden text-sm font-semibold sm:inline">Pesquisar</span>
  </span>
  <kbd
    class="hidden rounded border border-gray-200 bg-white px-1.5 py-0.5 font-sans text-[10px] font-bold text-gray-400 sm:inline"
    aria-hidden="true"
  >
    ⌘ K
  </kbd>
</button>

<dialog
  id="search-dialog"
  class="m-auto w-[calc(100%-1.25rem)] max-w-2xl overflow-visible rounded-lg border border-gray-200 bg-white p-0 text-gray-950 shadow-2xl backdrop:bg-gray-950/45 backdrop:backdrop-blur-[2px]"
  aria-labelledby="search-title"
>
  <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3">
    <div>
      <h2 id="search-title" class="text-sm font-extrabold">
        Buscar no acervo
      </h2>
      <p class="text-xs text-gray-500">Projetos e comunidade do IFPB</p>
    </div>
    <button
      id="search-close"
      type="button"
      class="grid h-9 w-9 place-items-center rounded-md text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-950"
      aria-label="Fechar busca"
      title="Fechar busca"
    >
      <Icon name="ph:x-bold" size={18} />
    </button>
  </div>
  <div class="global-search max-h-[min(70vh,38rem)] overflow-y-auto p-4">
    <div id="search"></div>
    <p
      id="search-unavailable"
      class="hidden py-8 text-center text-sm text-gray-500"
    >
      A busca estará disponível após gerar o índice do site.
    </p>
  </div>
  <footer class="hidden items-center gap-4 border-t border-gray-100 px-4 py-2 text-[11px] text-gray-400 sm:flex">
    <span>
      <kbd class="font-sans font-bold">↑↓</kbd> navegar
    </span>
    <span>
      <kbd class="font-sans font-bold">Enter</kbd> abrir
    </span>
    <span>
      <kbd class="font-sans font-bold">Esc</kbd> fechar
    </span>
  </footer>
</dialog>

<script>
  declare const PagefindUI: new (options: Record<string, unknown>) => void;

  const trigger = document.querySelector<HTMLButtonElement>("#search-command");
  const dialog = document.querySelector<HTMLDialogElement>("#search-dialog");
  const closeButton =
    document.querySelector<HTMLButtonElement>("#search-close");
  const unavailable = document.querySelector<HTMLElement>(
    "#search-unavailable",
  );
  let initialized = false;

  function initializeSearch() {
    if (initialized) return;
    if (typeof PagefindUI === "undefined") {
      unavailable?.classList.remove("hidden");
      return;
    }

    new PagefindUI({
      element: "#search",
      resetStyles: false,
      showImages: false,
      showSubResults: true,
      excerptLength: 18,
      translations: {
        placeholder: "Busque por projeto, pessoa, curso ou tecnologia...",
        clear_search: "Limpar",
        load_more: "Ver mais resultados",
        search_label: "Pesquisar",
        filters_label: "Filtros",
        zero_results: "Nenhum resultado para [SEARCH_TERM]",
        many_results: "[COUNT] resultados para [SEARCH_TERM]",
        one_result: "[COUNT] resultado para [SEARCH_TERM]",
        alt_search:
          "Nenhum resultado para [SEARCH_TERM]. Exibindo resultados para [DIFFERENT_TERM]",
        search_suggestion:
          "Nenhum resultado para [SEARCH_TERM]. Tente uma destas buscas:",
        searching: "Pesquisando por [SEARCH_TERM]...",
      },
    });
    initialized = true;
  }

  function openSearch() {
    if (!dialog || dialog.open) return;
    initializeSearch();
    dialog.showModal();
    requestAnimationFrame(() => {
      dialog
        .querySelector<HTMLInputElement>(".pagefind-ui__search-input")
        ?.focus();
    });
  }

  trigger?.addEventListener("click", openSearch);
  closeButton?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener("keydown", (event) => {
    if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;

    const links = Array.from(
      dialog.querySelectorAll<HTMLAnchorElement>(".pagefind-ui__result-link"),
    );
    if (!links.length) return;

    event.preventDefault();
    const current = links.indexOf(document.activeElement as HTMLAnchorElement);
    const direction = event.key === "ArrowDown" ? 1 : -1;
    const next =
      current < 0
        ? direction > 0
          ? 0
          : links.length - 1
        : current + direction;
    links[(next + links.length) % links.length].focus();
  });

  window.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      openSearch();
    }
  });
</script>
