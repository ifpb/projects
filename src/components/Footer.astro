---
import { Icon } from "astro-icon/components";
---

<footer class="border-t border-gray-200 bg-white">
  <div class="page-shell flex flex-col gap-4 py-8 text-sm text-gray-600 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-3">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 3 68 93"
        class="h-8 w-auto shrink-0"
        aria-hidden="true"
      >
        <g fill="#2f9e41">
          <rect x="24" y="4" width="20" height="20" rx="2" ry="2" />
          <rect x="48" y="4" width="20" height="20" rx="2" ry="2" />
          <rect x="0" y="28" width="20" height="20" rx="2" ry="2" />
          <rect x="24" y="28" width="20" height="20" rx="2" ry="2" />
          <rect x="0" y="52" width="20" height="20" rx="2" ry="2" />
          <rect x="24" y="52" width="20" height="20" rx="2" ry="2" />
          <rect x="48" y="52" width="20" height="20" rx="2" ry="2" />
          <rect x="0" y="76" width="20" height="20" rx="2" ry="2" />
          <rect x="24" y="76" width="20" height="20" rx="2" ry="2" />
        </g>
        <circle cx="10" cy="14" r="11" fill="#cd191e" />
      </svg>
      <p>
        <strong class="block text-gray-900">IFPB Projetos</strong>Conhecimento
        aberto, feito por nossa comunidade.
      </p>
    </div>
    <a
      href="https://github.com/ifpb/projects"
      class="inline-flex items-center gap-2 font-semibold text-gray-700 hover:text-green-800"
    >
      <Icon name="mdi:github" size={18} /> Contribua no GitHub
    </a>
  </div>
</footer>
