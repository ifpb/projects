<script is:inline>
  async function onLoadPersonImage(img) {
    img.onload = null;

    const avatar = img.getAttribute('data-src');

    if (!avatar || avatar === 'none' || img.src === avatar) {
      return;
    }

    try {
      // Pré-carrega a imagem do avatar em background
      const res = await fetch(avatar);
      if (!res.ok) return;

      const blob = await res.blob();

      // Avatares padrão/identicons do GitHub possuem menos de 2000 bytes
      // Nesses casos, mantém o nosso placeholder de estudante!
      if (blob.size < 2000) {
        return;
      }

      // Substituição gradual e suave via cross-fade para fotos reais
      img.style.transition = 'opacity 0.25s ease-in-out';
      img.style.opacity = '0';
      setTimeout(() => {
        img.src = avatar;
        img.style.opacity = '1';
      }, 120);
    } catch (err) {
      // Em caso de falha de conexão, mantém o placeholder de estudante
    }
  }

  function onErrorPersonImage(img) {
    img.onerror = null;
    img.src = '/projects/imgs/people-placeholder.png';
  }
</script>
