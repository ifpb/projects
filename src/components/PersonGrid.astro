---
import type { CollectionEntry } from "astro:content";
import PaginationIndex from "@/components/PaginationIndex.astro";
import PersonCard from "@/components/PersonCard.astro";
import PersonUtil from "@/components/PersonUtil.astro";

export interface Props {
  page: {
    data: CollectionEntry<"people">[];
    currentPage: number;
    lastPage: number;
    url?: {
      first?: string;
      prev: string;
      next: string;
      last?: string;
    };
  };
  type: string;
  index: string;
}

const { page, type, index }: Props = Astro.props;
---

<PersonUtil />

<main>
  <div
    class="grid gap-3 sm:gap-4 grid-cols-2 sm:grid-cols-3 md:grid-cols-3 lg:grid-cols-4 2xl:grid-cols-6"
    data-pagefind-ignore
  >
    {
      /* Cards da primeira fileira ficam eager */
      page.data.map((person, index) => (
        <PersonCard person={person} eager={index < 6} />
      ))
    }
  </div>

  {page.lastPage > 1 && (
    <PaginationIndex page={page} type={type} index={index} />
  )}
</main>
