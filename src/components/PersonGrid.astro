---
import type { CollectionEntry } from "astro:content";
import PaginationIndex from "@/components/PaginationIndex.astro";
import PersonCard from "@/components/PersonCard.astro";
import PersonUtil from "@/components/PersonUtil.astro";

export interface Props {
  page: {
    data: CollectionEntry<"people">[];
    currentPage: number;
    lastPage: number;
    url?: {
      first?: string;
      prev: string;
      next: string;
      last?: string;
    };
  };
  type: string;
  index: string;
}

const { page, type, index }: Props = Astro.props;
---

<PersonUtil />

<main>
  <div
    class="grid gap-5 grid-cols-1 min-[420px]:grid-cols-2 md:grid-cols-3 xl:grid-cols-4"
    data-pagefind-ignore
  >
    {
      /* As primeiras duas fileiras (8 cards no desktop) ficam acima da dobra. */
      page.data.map((person, index) => (
        <PersonCard person={person} eager={index < 8} />
      ))
    }
  </div>

  {page.lastPage > 1 && (
    <PaginationIndex page={page} type={type} index={index} />
  )}
</main>
