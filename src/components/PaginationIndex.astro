---
import type { ProjectsWithPeople } from "@/pages/codes/page/[page].astro";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { url } from "@/lib/url";

export interface Props {
  type: string;
  index: string;
  page: {
    data: (ProjectsWithPeople | CollectionEntry<"people">)[];
    currentPage: number;
    lastPage: number;
  };
}

const { page, type, index }: Props = Astro.props;
const pageUrl = (pageNumber: number) => url(`${type}/${index}/${pageNumber}`);
const prevUrl =
  page.currentPage > 1 ? pageUrl(page.currentPage - 1) : undefined;
const nextUrl =
  page.currentPage < page.lastPage ? pageUrl(page.currentPage + 1) : undefined;
const firstUrl = page.currentPage > 1 ? pageUrl(1) : undefined;
const lastUrl =
  page.currentPage < page.lastPage ? pageUrl(page.lastPage) : undefined;

function getPageNumbers(size: number, lastPage: number, currentPage: number) {
  let start = Math.max(1, currentPage - Math.floor(size / 2));
  const end = Math.min(lastPage, start + size - 1);
  start = Math.max(1, end - size + 1);
  return Array.from({ length: end - start + 1 }, (_, i) => start + i);
}

const pages = getPageNumbers(5, page.lastPage, page.currentPage);
const controlClass =
  "grid h-10 min-w-10 place-items-center rounded-md border border-gray-300 bg-white px-3 text-sm font-bold text-gray-700 transition-colors hover:border-green-700 hover:text-green-800";
---

<nav
  class="pagination-nav mt-12 flex flex-col items-center gap-4 border-t border-gray-200 pt-8"
  aria-label="Paginação"
  data-prev-url={prevUrl}
  data-next-url={nextUrl}
>
  <div class="flex flex-wrap items-center justify-center gap-3 text-sm text-gray-500">
    <p>
      Página <strong class="text-gray-900">{page.currentPage}</strong> de{" "}
      <strong class="text-gray-900">{page.lastPage}</strong>
    </p>

    {page.lastPage > 5 && (
      <div class="flex items-center gap-1.5 text-xs text-gray-500">
        <label for="pagination-jump" class="hidden sm:inline font-medium">Ir para:</label>
        <select
          id="pagination-jump"
          class="rounded-md border border-gray-300 bg-white px-2 py-1 text-xs font-bold text-gray-800 shadow-2xs transition-colors focus:border-green-700 focus:outline-none"
          onchange="if (this.value) window.location.href = this.value;"
          aria-label="Ir diretamente para a página"
        >
          {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((p) => (
            <option value={pageUrl(p)} selected={p === page.currentPage}>
              Pág. {p}
            </option>
          ))}
        </select>
      </div>
    )}

    <div class="hidden items-center gap-1 text-[11px] text-gray-400 lg:flex">
      <span>Atalhos:</span>
      <kbd class="rounded border border-gray-200 bg-gray-100 px-1.5 py-0.5 font-mono font-bold text-gray-600" title="Página anterior">←</kbd>
      <kbd class="rounded border border-gray-200 bg-gray-100 px-1.5 py-0.5 font-mono font-bold text-gray-600" title="Próxima página">→</kbd>
    </div>
  </div>

  <ul class="flex flex-wrap items-center justify-center gap-1.5">
    <li>
      {firstUrl ? (
        <a href={firstUrl} title="Primeira página" aria-label="Primeira página" class={controlClass}>
          <Icon name="ph:caret-double-left-bold" size={16} />
        </a>
      ) : (
        <span
          aria-hidden="true"
          class={`${controlClass} cursor-not-allowed opacity-40`}
        >
          <Icon name="ph:caret-double-left-bold" size={16} />
        </span>
      )}
    </li>
    <li>
      {prevUrl ? (
        <a
          href={prevUrl}
          title="Página anterior (atalho: ←)"
          aria-label="Página anterior (atalho: tecla seta esquerda)"
          class={controlClass}
        >
          <Icon name="ph:caret-left-bold" size={16} />
        </a>
      ) : (
        <span
          aria-hidden="true"
          class={`${controlClass} cursor-not-allowed opacity-40`}
        >
          <Icon name="ph:caret-left-bold" size={16} />
        </span>
      )}
    </li>
    {pages.map((pageNumber) => (
      <li
        class:list={[
          Math.abs(pageNumber - page.currentPage) > 1 && "hidden sm:block",
        ]}
      >
        <a
          href={pageUrl(pageNumber)}
          aria-label={`Página ${pageNumber}`}
          aria-current={pageNumber === page.currentPage ? "page" : undefined}
          class:list={[
            controlClass,
            pageNumber === page.currentPage &&
              "!border-green-700 !bg-green-700 !text-white",
          ]}
        >
          {pageNumber}
        </a>
      </li>
    ))}
    <li>
      {nextUrl ? (
        <a
          href={nextUrl}
          title="Próxima página (atalho: →)"
          aria-label="Próxima página (atalho: tecla seta direita)"
          class={controlClass}
        >
          <Icon name="ph:caret-right-bold" size={16} />
        </a>
      ) : (
        <span
          aria-hidden="true"
          class={`${controlClass} cursor-not-allowed opacity-40`}
        >
          <Icon name="ph:caret-right-bold" size={16} />
        </span>
      )}
    </li>
    <li>
      {lastUrl ? (
        <a href={lastUrl} title="Última página" aria-label="Última página" class={controlClass}>
          <Icon name="ph:caret-double-right-bold" size={16} />
        </a>
      ) : (
        <span
          aria-hidden="true"
          class={`${controlClass} cursor-not-allowed opacity-40`}
        >
          <Icon name="ph:caret-double-right-bold" size={16} />
        </span>
      )}
    </li>
  </ul>
</nav>

<script is:inline>
  document.addEventListener("keydown", (e) => {
    const target = e.target;
    if (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target instanceof HTMLSelectElement ||
      target?.isContentEditable ||
      document.querySelector("dialog[open]")
    ) {
      return;
    }

    const nav = document.querySelector(".pagination-nav");
    if (!nav) return;

    if (e.key === "ArrowLeft") {
      const prevUrl = nav.getAttribute("data-prev-url");
      if (prevUrl) {
        window.location.href = prevUrl;
      }
    } else if (e.key === "ArrowRight") {
      const nextUrl = nav.getAttribute("data-next-url");
      if (nextUrl) {
        window.location.href = nextUrl;
      }
    }
  });
</script>
