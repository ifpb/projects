---
import type { ProjectsWithPeople } from '@/pages/codes/page/[page].astro';
import type { CollectionEntry } from 'astro:content';
import { url } from '@/lib/url';

export interface Props {
  type: string;
  index: string;
  page: {
    data: (ProjectsWithPeople | CollectionEntry<'people'>)[];
    currentPage: number;
    lastPage: number;
    url?: {
      first?: string;
      prev: string;
      next: string;
      last?: string;
    };
  };
}

const { page, type, index }: Props = Astro.props;

const pagePath = `${type}/${index}`;

// As URLs são montadas aqui, e não a partir de `page.url.*`, porque o formato
// daquele objeto mudou entre majors do Astro (a v5 passou a incluir o `base`).
const pageUrl = (pageNumber: number) => url(`${pagePath}/${pageNumber}`);

const firstUrl = pageUrl(1);
const lastUrl = pageUrl(page.lastPage);
// `undefined` faz o Astro omitir o atributo: um `<a>` sem `href` não é link, enquanto
// `href=""` apontaria para a própria página.
const prevUrl =
  page.currentPage > 1 ? pageUrl(page.currentPage - 1) : undefined;
const nextUrl =
  page.currentPage < page.lastPage ? pageUrl(page.currentPage + 1) : undefined;

function getPageNumbers(
  size: number,
  lastPage: number,
  currentPage: number
): number[] {
  let pages = [];
  let start = Math.max(1, currentPage - Math.floor(size / 2));
  let end = Math.min(lastPage, start + size - 1);
  start = Math.max(1, end - size + 1);
  for (let i = start; i <= end; i++) {
    pages.push(i);
  }
  return pages;
}

const pages = getPageNumbers(4, page.lastPage, page.currentPage);

const stepClass =
  'px-4 py-2 text-slate-600 transition-colors duration-150 bg-white border border-r-0 border-slate-600 focus:shadow-outline hover:bg-slate-100';
---

<div class="mt-12 flex items-center flex-wrap justify-center">
  <nav aria-label="Page navigation">
    <ul class="flex flex-row">
      <li>
        <a
          href={firstUrl}
          aria-label="Primeira página"
          class={`${stepClass} rounded-l-lg`}
        >
          &laquo;
        </a>
      </li>
      <li>
        {
          prevUrl ? (
            <a href={prevUrl} aria-label="Página anterior" class={stepClass}>
              &lsaquo;
            </a>
          ) : (
            <span aria-hidden="true" class={`${stepClass} opacity-50`}>
              &lsaquo;
            </span>
          )
        }
      </li>
      {
        pages.map((pageNumber) => (
          <li>
            <a
              href={pageUrl(pageNumber)}
              aria-label={`Página ${pageNumber}`}
              aria-current={pageNumber === page.currentPage ? 'page' : undefined}
              class={`${
                pageNumber === page.currentPage
                  ? 'text-white bg-slate-600'
                  : 'text-slate-600 bg-white'
              } px-4 py-2 border border-r-0 border-slate-600 focus:shadow-outline transition-colors duration-150`}
            >
              {pageNumber}
            </a>
          </li>
        ))
      }
      <li>
        {
          nextUrl ? (
            <a href={nextUrl} aria-label="Próxima página" class={stepClass}>
              &rsaquo;
            </a>
          ) : (
            <span aria-hidden="true" class={`${stepClass} opacity-50`}>
              &rsaquo;
            </span>
          )
        }
      </li>
      <li>
        <a
          href={lastUrl}
          aria-label="Última página"
          class={`${stepClass} rounded-r-lg border-r`}
        >
          &raquo;
        </a>
      </li>
    </ul>
  </nav>
</div>
