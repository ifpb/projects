---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="Página não encontrada">
  <div class="flex flex-col justify-center items-center py-12" data-pagefind-ignore>
    <h2 class="text-8xl sm:text-9xl font-extrabold text-gray-900 tracking-widest">404</h2>
    <div class="bg-[#FF6A3D] text-white px-3 py-1.5 text-sm font-medium rounded-md mt-4">
      Oxente! Num achei essa página, não!
    </div>
    <div class="mt-8">
      <a
        class="inline-block rounded-sm border border-gray-900 bg-gray-900 px-8 py-3 text-sm font-medium text-white hover:bg-transparent hover:text-gray-900 focus:outline-hidden active:text-white/75"
        href="/projects/"
      >
        Tela Inicial
      </a>
    </div>
  </div>
</BaseLayout>

