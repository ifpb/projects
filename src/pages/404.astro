---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Página não encontrada">
  <div class="py-12 text-center sm:py-20" data-pagefind-ignore>
    <p class="text-8xl font-black text-green-700 sm:text-9xl">404</p>
    <h2 class="mt-5 text-2xl font-extrabold text-gray-950">
      Oxente! Essa página não apareceu por aqui.
    </h2>
    <p class="mx-auto mt-3 max-w-md text-gray-600">
      O endereço pode ter mudado ou o conteúdo ainda não faz parte do acervo.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        class="rounded-md bg-green-700 px-5 py-3 text-sm font-bold text-white hover:bg-green-800"
        href="/projects/"
      >
        Voltar ao início
      </a>
      <a
        class="rounded-md border border-gray-300 bg-white px-5 py-3 text-sm font-bold text-gray-800 hover:border-green-700 hover:text-green-800"
        href="/projects/codes/page/1"
      >
        Explorar projetos
      </a>
    </div>
  </div>
</BaseLayout>
