---
import Filter from "@/components/Filter";
import Footer from "@/components/Footer.astro";
import GoogleAnalytics from "@/components/GoogleAnalytics.astro";
import NavBar from "@/components/NavBar.astro";
import { getAllPersonTags } from "@/helpers/people";
import { getAllProjectTags } from "@/helpers/tags";
import { courses, getCourse } from "@/helpers/courses";
import { getSubject, subjects } from "@/helpers/subjects";
import type { CourseInfo, SubjectInfo } from "@/lib/taxonomy";
import "@/styles/global.css";

export interface Props {
  pageTitle?: string;
  pageDescription?: string;
  tags?: any;
  type?: string;
  pageFindFilter?: string;
  image?: string;
  ogType?: "website" | "article" | "profile";
}

const {
  pageTitle,
  pageDescription,
  tags,
  type,
  pageFindFilter,
  image,
  ogType = "website",
} = Astro.props;
const peopleTags = tags && type === "people" ? await getAllPersonTags() : [];
const projectTags: string[] =
  tags && type === "codes"
    ? (await getAllProjectTags()).filter((tag) => {
        if (getCourse(tag) || getSubject(tag)) return false;
        return !/^[a-zA-Z0-9]+-[a-zA-Z]+-[a-zA-Z]+-\d{4}\.\d+$/.test(tag);
      })
    : [];

const courseInfos: CourseInfo[] = courses.map(({ data }) => ({
  id: data.id,
  name: data.name,
  abbreviation: data.abbreviation,
  level: data.level.compact,
}));
const subjectInfos: SubjectInfo[] = subjects.map(({ data }) => ({
  id: data.id,
  name: data.name.full,
}));
const headerTitle = pageTitle
  ? `${pageTitle} | IFPB Projetos`
  : "IFPB Projetos · Conhecimento Aberto";
const hasHeaderActions = Astro.slots.has("header-actions");
const sectionLabel =
  type === "people" || pageFindFilter === "tipo:Pessoas"
    ? "Comunidade IFPB"
    : "Projetos IFPB";

const siteUrl = Astro.site ?? new URL("https://ifpb.github.io");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const metaDescription =
  pageDescription ??
  "Projetos, pessoas e produção acadêmica da comunidade do IFPB.";
const defaultOgImage = new URL(
  "/projects/imgs/project-placeholder.png",
  siteUrl,
).href;
const metaImage = image
  ? image.startsWith("http")
    ? image
    : new URL(image, siteUrl).href
  : defaultOgImage;
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/projects/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#168821" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("ifpb-theme");
        const systemTheme = matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
        document.documentElement.dataset.theme = savedTheme || systemTheme;
      })();
    </script>
    <title>{headerTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={headerTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:site_name" content="IFPB Projetos" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={headerTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={metaImage} />

    <link href="/projects/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script
      src="/projects/pagefind/pagefind-ui.js"
      type="text/javascript"
    ></script>
  </head>
  <body class="flex min-h-screen flex-col">
    <NavBar />
    <main class="page-shell flex-1 py-8 sm:py-10 lg:py-12">
      {pageTitle && (
        <header class="mb-8 border-b border-gray-200 pb-6 sm:mb-10">
          <p class="section-label mb-2">{sectionLabel}</p>
          <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
            <div class="max-w-3xl">
              <h1
                class="text-3xl font-extrabold leading-tight text-gray-950 sm:text-4xl"
                data-pagefind-filter={pageFindFilter}
              >
                {pageTitle}
              </h1>
              {pageDescription && (
                <p class="mt-3 text-base leading-7 text-gray-600">
                  {pageDescription}
                </p>
              )}
            </div>
            {(hasHeaderActions || tags) && (
              <div class="flex flex-wrap items-center gap-3">
                <slot name="header-actions" />
                {tags && (
                  <Filter
                    type={type}
                    tags={tags}
                    peopleTags={peopleTags}
                    projectTags={projectTags}
                    courses={courseInfos}
                    subjects={subjectInfos}
                    client:idle
                  />
                )}
              </div>
            )}
          </div>
        </header>
      )}
      <slot />
    </main>
    <Footer />
    <GoogleAnalytics />
  </body>
</html>
